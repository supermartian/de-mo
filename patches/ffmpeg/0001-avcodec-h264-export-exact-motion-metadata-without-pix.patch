@@ -1093,6 +1215,7 @@ static const AVOption h264_options[] = {
     { "is_avc", "is avc", OFFSET(is_avc), AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, VDX },
     { "nal_length_size", "nal_length_size", OFFSET(nal_length_size), AV_OPT_TYPE_INT, {.i64 = 0}, 0, 4, VDX },
     { "enable_er", "Enable error resilience on damaged frames (unsafe)", OFFSET(enable_er), AV_OPT_TYPE_BOOL, { .i64 = -1 }, -1, 1, VD },
+    { "motion_metadata_only", "Decode H.264 syntax and motion metadata without reconstructing pixels", OFFSET(motion_metadata_only), AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, VD },
