         write_back_motion_list(h, sl, b_stride, b_xy, b8_xy, mb_type, 0);
     } else {
         fill_rectangle(&h->cur_pic.ref_index[0][b8_xy],
                        2, 2, 2, (uint8_t)LIST_NOT_USED, 1);
+        memset(&h->cur_pic.motion_ref[0][b8_xy], 0,
+               4 * sizeof(*h->cur_pic.motion_ref[0]));
     }
-    if (USES_LIST(mb_type, 1))
+    if (USES_LIST(mb_type, 1)) {
         write_back_motion_list(h, sl, b_stride, b_xy, b8_xy, mb_type, 1);
+    } else {
+        fill_rectangle(&h->cur_pic.ref_index[1][b8_xy],
+                       2, 2, 2, (uint8_t)LIST_NOT_USED, 1);
+        memset(&h->cur_pic.motion_ref[1][b8_xy], 0,
+               4 * sizeof(*h->cur_pic.motion_ref[1]));
+    }
 
     if (sl->slice_type_nos == AV_PICTURE_TYPE_B && CABAC(h)) {
         if (IS_8X8(mb_type)) {
