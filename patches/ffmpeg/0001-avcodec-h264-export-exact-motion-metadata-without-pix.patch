 #include "libavutil/video_enc_params.h"
@@ -59,6 +60,110 @@
 
 const uint16_t ff_h264_mb_sizes[4] = { 256, 384, 512, 768 };
 
+#define H264_MV_PTS_MIN (-(INT64_C(1) << 47))
+#define H264_MV_PTS_MAX ((INT64_C(1) << 47) - 1)
+
+static uint64_t h264_motion_flags(const H264MotionReference *reference)
+{
+    uint64_t flags = reference->flags;
+
+    if (flags & AV_MV_FLAG_PTS_DELTA_VALID) {
+        if (reference->pts_delta < H264_MV_PTS_MIN ||
+            reference->pts_delta > H264_MV_PTS_MAX) {
+            flags &= ~AV_MV_FLAG_PTS_DELTA_VALID;
+        } else {
+            flags |= ((uint64_t)reference->pts_delta &
+                      UINT64_C(0x0000ffffffffffff)) <<
+                     AV_MV_FLAG_PTS_DELTA_SHIFT;
+        }
+    }
+    return flags;
+}
+
+static void add_h264_motion_vector(AVMotionVector *output,
+                                   const H264Picture *picture,
+                                   int list, int b_xy, int b8_xy,
+                                   int dst_x, int dst_y, int width, int height,
+                                   int vertical_multiplier)
+{
+    const H264MotionReference *reference = &picture->motion_ref[list][b8_xy];
+    const int16_t *motion = picture->motion_val[list][b_xy];
+
+    output->source       = reference->poc_delta;
+    output->w            = width;
+    output->h            = height;
+    output->dst_x        = dst_x;
+    output->dst_y        = dst_y;
+    output->motion_x     = motion[0];
+    output->motion_y     = motion[1] * vertical_multiplier;
+    output->motion_scale = 4;
+    output->src_x        = dst_x + motion[0] / 4;
+    output->src_y        = dst_y + output->motion_y / 4;
+    output->flags        = h264_motion_flags(reference);
+}
+
+static int h264_export_motion_vectors(AVFrame *frame,
+                                      const H264Picture *picture)
+{
+    size_t capacity;
+    AVMotionVector *vectors;
+    size_t count = 0;
+
+    if (av_size_mult((size_t)picture->mb_width * picture->mb_height,
+                     32, &capacity) < 0)
+        return AVERROR(EINVAL);
+    vectors = av_calloc(capacity, sizeof(*vectors));
+    if (!vectors && capacity)
+        return AVERROR(ENOMEM);
+
+    for (int mb_y = 0; mb_y < picture->mb_height; mb_y++) {
+        for (int mb_x = 0; mb_x < picture->mb_width; mb_x++) {
+            const int mb_xy = mb_x + mb_y * picture->mb_stride;
+            const int mb_type = picture->mb_type[mb_xy];
+            const int vertical_multiplier =
+                IS_INTERLACED(mb_type) &&
+                (IS_16X8(mb_type) || IS_8X16(mb_type)) ? 2 : 1;
+            if (!IS_INTER(mb_type) && !IS_DIRECT(mb_type))
+                continue;
+            for (int y = 0; y < 4; y++) {
+                for (int x = 0; x < 4; x++) {
+                    const int partition =
+                        picture->motion_partition[16 * mb_xy + 4 * y + x];
+                    const int width = 4 * (partition >> 4);
+                    const int height = 4 * (partition & 15);
+                    const int dst_x = mb_x * 16 + x * 4 + width / 2;
+                    const int dst_y = mb_y * 16 + y * 4 + height / 2;
+                    const int b_xy = mb_x * 4 + x +
+                                     (mb_y * 4 + y) * picture->b_stride;
+                    const int b8_xy = mb_xy * 4 + (x >> 1) + 2 * (y >> 1);
+                    if (!partition)
+                        continue;
+                    for (int list = 0; list < 2; list++) {
+                        if (!(picture->motion_ref[list][b8_xy].flags &
+                              AV_MV_FLAG_REFERENCE_EXACT))
+                            continue;
+                        add_h264_motion_vector(&vectors[count++], picture, list,
+                                               b_xy, b8_xy, dst_x, dst_y,
+                                               width, height,
+                                               vertical_multiplier);
+                    }
+                }
+            }
+        }
+    }
+    if (count) {
+        AVFrameSideData *side_data = av_frame_new_side_data(
+            frame, AV_FRAME_DATA_MOTION_VECTORS, count * sizeof(*vectors));
+        if (!side_data) {
+            av_free(vectors);
+            return AVERROR(ENOMEM);
+        }
+        memcpy(side_data->data, vectors, count * sizeof(*vectors));
+    }
+    av_free(vectors);
+    return 0;
+}
