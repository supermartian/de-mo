+static av_always_inline H264MotionReference motion_reference(
+    const H264Context *h, const H264SliceContext *sl, int list, int ref_index)
+{
+    H264MotionReference result = { 0 };
+    const H264Ref *reference;
+    int64_t poc_delta;
+    int current_poc = h->cur_pic_ptr->poc;
+
+    if (ref_index < 0 || ref_index >= sl->ref_count[list])
+        return result;
+
+    reference = &sl->ref_list[list][ref_index];
+    if (!reference->parent)
+        return result;
+
+    if (FIELD_PICTURE(h))
+        current_poc = h->cur_pic_ptr->field_poc[h->picture_structure == PICT_BOTTOM_FIELD];
+    else if (MB_FIELD(sl))
+        current_poc = h->cur_pic_ptr->field_poc[sl->mb_y & 1];
+
+    poc_delta = (int64_t)reference->poc - current_poc;
+    if (poc_delta < INT32_MIN || poc_delta > INT32_MAX)
+        return result;
+
+    result.poc_delta = poc_delta;
+    result.flags = ref_index & AV_MV_FLAG_REFERENCE_INDEX_MASK;
+    result.flags |= list ? AV_MV_FLAG_REFERENCE_LIST1 : 0;
+    result.flags |= reference->parent->long_ref ? AV_MV_FLAG_LONG_REFERENCE : 0;
+    result.flags |= reference->reference & PICT_TOP_FIELD ?
+                    AV_MV_FLAG_REFERENCE_TOP_FIELD : 0;
+    result.flags |= reference->reference & PICT_BOTTOM_FIELD ?
+                    AV_MV_FLAG_REFERENCE_BOTTOM_FIELD : 0;
+    result.flags |= AV_MV_FLAG_REFERENCE_EXACT;
+    if (h->cur_pic.f->pts != AV_NOPTS_VALUE &&
+        reference->parent->f->pts != AV_NOPTS_VALUE) {
+        result.pts_delta = av_sat_sub64(reference->parent->f->pts,
+                                        h->cur_pic.f->pts);
+        result.flags |= AV_MV_FLAG_PTS_DELTA_VALID;
+    }
+    return result;
+}
+
+static av_always_inline void write_back_motion_references(
+    const H264Context *h, H264SliceContext *sl, int list, int b8_xy,
+    int mb_type)
+{
+    H264MotionReference *references = &h->cur_pic.motion_ref[list][b8_xy];
+    const int8_t *cache = sl->ref_cache[list];
+
+    references[0] = motion_reference(h, sl, list, cache[scan8[0]]);
+    references[1] = motion_reference(h, sl, list, cache[scan8[4]]);
+    references[2] = motion_reference(h, sl, list, cache[scan8[8]]);
+    references[3] = motion_reference(h, sl, list, cache[scan8[12]]);
+    for (int i = 0; i < 4; i++) {
+        const int direct = IS_DIRECT(mb_type) ||
+                           (IS_8X8(mb_type) && IS_DIRECT(sl->sub_mb_type[i]));
+        references[i].flags |= direct ? AV_MV_FLAG_DIRECT : 0;
+        references[i].flags |= IS_SKIP(mb_type) ? AV_MV_FLAG_SKIP : 0;
+        references[i].flags |= IS_INTERLACED(mb_type) ?
+                               AV_MV_FLAG_INTERLACED : 0;
+    }
+}
+
+static av_always_inline void mark_motion_partition(uint8_t *partitions,
+                                                   int x, int y,
+                                                   int width, int height)
+{
+    partitions[4 * y + x] = (width << 4) | height;
+}
+
+static av_always_inline void write_back_motion_partitions(
+    const H264Context *h, const H264SliceContext *sl, int mb_type)
+{
+    uint8_t *partitions = &h->cur_pic.motion_partition[16 * sl->mb_xy];
+
+    memset(partitions, 0, 16);
+    if (IS_8X8(mb_type)) {
+        for (int i = 0; i < 4; i++) {
+            const int type = sl->sub_mb_type[i];
+            const int x = 2 * (i & 1);
+            const int y = 2 * (i >> 1);
+            if (IS_SUB_8X8(type)) {
+                mark_motion_partition(partitions, x, y, 2, 2);
+            } else if (IS_SUB_8X4(type)) {
+                mark_motion_partition(partitions, x, y, 2, 1);
+                mark_motion_partition(partitions, x, y + 1, 2, 1);
+            } else if (IS_SUB_4X8(type)) {
+                mark_motion_partition(partitions, x, y, 1, 2);
+                mark_motion_partition(partitions, x + 1, y, 1, 2);
+            } else {
+                mark_motion_partition(partitions, x, y, 1, 1);
+                mark_motion_partition(partitions, x + 1, y, 1, 1);
+                mark_motion_partition(partitions, x, y + 1, 1, 1);
+                mark_motion_partition(partitions, x + 1, y + 1, 1, 1);
+            }
+        }
+    } else if (IS_16X8(mb_type)) {
+        mark_motion_partition(partitions, 0, 0, 4, 2);
+        mark_motion_partition(partitions, 0, 2, 4, 2);
+    } else if (IS_8X16(mb_type)) {
+        mark_motion_partition(partitions, 0, 0, 2, 4);
+        mark_motion_partition(partitions, 2, 0, 2, 4);
+    } else {
+        mark_motion_partition(partitions, 0, 0, 4, 4);
+    }
+}
+
 static av_always_inline void write_back_motion_list(const H264Context *h,
                                                     H264SliceContext *sl,
                                                     int b_stride,
@@ -124,6 +232,7 @@ static av_always_inline void write_back_motion_list(const H264Context *h,
         ref_index[1 + 0 * 2] = ref_cache[scan8[4]];
         ref_index[0 + 1 * 2] = ref_cache[scan8[8]];
         ref_index[1 + 1 * 2] = ref_cache[scan8[12]];
+        write_back_motion_references(h, sl, list, b8_xy, mb_type);
     }
 }
 
@@ -135,14 +244,24 @@ static av_always_inline void write_back_motion(const H264Context *h,
     const int b_xy  = 4 * sl->mb_x + 4 * sl->mb_y * h->b_stride; // try mb2b(8)_xy
     const int b8_xy = 4 * sl->mb_xy;
 
+    write_back_motion_partitions(h, sl, mb_type);
